
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Allow public read on jobs, but only recruiters can write.
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.token.role == 'recruiter';
    }

    // Any authenticated user can read profiles, but only the owner can write.
    match /candidates/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    match /recruiters/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }
    
    match /admins/{userId} {
      allow read, write: if request.auth.uid == userId && request.auth.token.role == 'admin';
    }

    // A user can create their own application. 
    // A user can read/update/delete their own application.
    // A recruiter can read any application.
    match /applications/{applicationId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.candidateId;
      allow read, update, delete: if request.auth != null && 
                                    (request.auth.uid == resource.data.candidateId || 
                                     request.auth.token.role == 'recruiter');
    }

    // Participants of a conversation can read and write to it.
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participants;
    }
  }
}
