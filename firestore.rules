
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read access to jobs for the map feature
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && get(/databases/$(database)/documents/recruiters/$(request.auth.uid)).data.role == 'recruiter';
    }

    // Allow users to manage their own profile, but let any logged-in user read it
    match /candidates/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow recruiters to manage their own profile, but let any logged-in user read it
    match /recruiters/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow admins to manage their own profile
    match /admins/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for applications
    match /applications/{applicationId} {
      allow read, write: if request.auth != null;
    }

    // Rules for conversations
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participants;
    }

    // Fallback for other collections - deny all access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
