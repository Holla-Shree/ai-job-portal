
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default allow read access for authenticated users.
    // This is a broad rule for prototyping, can be refined later.
    match /{document=**} {
      allow read: if request.auth != null;
    }

    // Candidates can write to their own documents.
    match /candidates/{candidateId} {
      allow write: if request.auth != null;
    }

    // Recruiters can write to their own documents.
    match /recruiters/{recruiterId} {
      allow write: if request.auth != null;
    }

    // Admins can write to their own documents.
    match /admins/{adminId} {
      allow write: if request.auth != null;
    }
    
    // Recruiters can write to jobs.
    match /jobs/{jobId} {
        allow write: if request.auth != null;
    }
    
    // Users can create/update their own applications.
    match /applications/{applicationId} {
        allow write: if request.auth != null;
    }
    
    // Users can write to conversations they are a part of.
    match /conversations/{conversationId} {
        allow write: if request.auth != null;
    }
  }
}
