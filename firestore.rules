
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read access to jobs for the map feature
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && get(/databases/$(database)/documents/recruiters/$(request.auth.uid)).data.role == 'recruiter';
    }

    // Allow any authenticated user to read candidate and recruiter profiles
    match /candidates/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /recruiters/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow admins to manage their own profile
    match /admins/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for applications. A user can read their own, a recruiter can read any.
    match /applications/{applicationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == resource.data.candidateId || get(/databases/$(database)/documents/recruiters/$(request.auth.uid)).data.role == 'recruiter');
    }

    // Rules for conversations
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participants;
    }
  }
}
